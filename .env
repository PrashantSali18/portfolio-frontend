# ─────────────────────────────────────────────────
# Environment Variables — Prashant Sali Portfolio
# ─────────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
# Variables MUST start with VITE_ to be accessible
# in the browser via import.meta.env.VITE_XXX
# ─────────────────────────────────────────────────

# Site URL (used for OG tags, canonical URLs)
VITE_SITE_URL=https://prashant-portfolio.vercel.app

# EmailJS — if you want a real email form (optional)
# Sign up free at https://www.emailjs.com
# VITE_EMAILJS_SERVICE_ID=gmail
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Google Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX

# Backend API URL
# Local dev:    http://localhost:5000
# After deploy: https://your-app-name.onrender.com
VITE_BACKEND_URL=http://localhost:5000
